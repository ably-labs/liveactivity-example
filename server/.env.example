# Ably API key (Account → App → API Keys). Needs the Push Admin and Publish
# capabilities. The APNs auth key (.p8) and the Firebase service account JSON
# are uploaded to the Ably app's Push settings, so this server authenticates to
# Ably only — it never talks to APNs or FCM itself.
ABLY_API_KEY=your_app.key_id:key_secret

# Port for the dashboard web server
PORT=3000
